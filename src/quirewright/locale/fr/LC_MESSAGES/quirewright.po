msgid "Drag to draw a line · Shift snaps to 45°"
msgstr "Glissez pour tracer une ligne · Maj contraint à 45°"

msgid "Drag to draw a rectangle · Shift for a square"
msgstr "Glissez pour tracer un rectangle · Maj pour un carré"

msgid "Drag to draw an ellipse · Shift for a circle"
